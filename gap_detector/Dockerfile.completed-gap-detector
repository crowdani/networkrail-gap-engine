FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    kafka-python==2.0.2 \
    psycopg2-binary>=2.9

# infill_predictor.py is imported at startup — both files must be present
COPY completed_journey_gap_detector.py .
COPY infill_predictor.py .

CMD ["python3", "-u", "completed_journey_gap_detector.py"]
