<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project-local Maven settings for the gap-approval-process kjar.

  Use with:
    mvn -s settings.xml clean install -DskipTests

  This routes both dependency and plugin resolution through the Red Hat GA
  Maven repository, where kie-maven-plugin and the jBPM/KIE artifacts live.
  They are NOT published to Maven Central.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.1.0
                              http://maven.apache.org/xsd/settings-1.1.0.xsd">

  <profiles>
    <profile>
      <id>redhat-ga</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>

      <repositories>
        <repository>
          <id>redhat-ga</id>
          <name>Red Hat GA</name>
          <url>https://maven.repository.redhat.com/ga/</url>
          <layout>default</layout>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
          <id>central</id>
          <name>Maven Central</name>
          <url>https://repo.maven.apache.org/maven2</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>

      <pluginRepositories>
        <pluginRepository>
          <id>redhat-ga-plugins</id>
          <name>Red Hat GA (plugins)</name>
          <url>https://maven.repository.redhat.com/ga/</url>
          <layout>default</layout>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
        <pluginRepository>
          <id>central-plugins</id>
          <name>Maven Central (plugins)</name>
          <url>https://repo.maven.apache.org/maven2</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

</settings>
