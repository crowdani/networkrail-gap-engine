<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gap Approval Process — IBM BAMOE 8 / jBPM 7.67 compatible

  Flow overview
  ─────────────
  Start (journey data injected as process vars)
    │
    ▼
  [Service Task] Fetch Stops  — GET /api/predicted-gaps/journey/{trainId}
    │                           → populates pendingStopIds (comma-sep list)
    │
    ▼
  [User Task]   Review Journey  — operator reviews all stops in Business Central
    │            inputs:  trainId, trainUid, scheduleDate, severity,
    │                     missedStops, totalStops, pendingStopIds, journeyUrl
    │            outputs: approvalDecision (APPROVE_ALL | REJECT_ALL | PARTIAL)
    │                     approvedTime, rejectionReason
    │
    ├─(SLA timer 4h)──────────────────────────────────────┐
    │                                                      │
    ▼                                                      ▼
  [Exclusive GW] Decision                         [Service Task] Auto-Approve
    │                                                      │
    ├── APPROVE_ALL ──▶ [Service Task] Approve Stops       │
    │                          │                           │
    ├── REJECT_ALL  ──▶ [Service Task] Reject Stops        │
    │                          │                           │
    └── PARTIAL     ──▶ [User Task] Per-Stop Review        │
                               │                           │
  ┌────────────────────────────┘                           │
  │                                                        │
  ▼                                                        │
  [End] Complete ◀─────────────────────────────────────────┘
-->
<definitions
    xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:tns="https://www.networkrail.co.uk/gap"
    xmlns:drools="http://www.jboss.org/drools"
    typeLanguage="http://www.java.com/javaTypes"
    expressionLanguage="http://www.mvel.org/2.0"
    targetNamespace="https://www.networkrail.co.uk/gap">

  <!-- ── Item definitions (process variable types) ─────────────────────── -->
  <itemDefinition id="_trainIdItem"          structureRef="String"/>
  <itemDefinition id="_trainUidItem"         structureRef="String"/>
  <itemDefinition id="_scheduleDateItem"     structureRef="String"/>
  <itemDefinition id="_severityItem"         structureRef="String"/>
  <itemDefinition id="_missedStopsItem"      structureRef="Integer"/>
  <itemDefinition id="_totalStopsItem"       structureRef="Integer"/>
  <itemDefinition id="_pendingStopIdsItem"   structureRef="String"/>
  <itemDefinition id="_journeyUrlItem"       structureRef="String"/>
  <itemDefinition id="_apiBaseUrlItem"       structureRef="String"/>
  <itemDefinition id="_approvalDecisionItem" structureRef="String"/>
  <itemDefinition id="_approvedTimeItem"     structureRef="String"/>
  <itemDefinition id="_rejectionReasonItem"  structureRef="String"/>
  <itemDefinition id="_httpResponseItem"     structureRef="String"/>

  <!-- ── Process ────────────────────────────────────────────────────────── -->
  <process id="GapApprovalProcess"
           name="Gap Approval Process"
           isExecutable="true"
           processType="Public"
           tns:packageName="com.networkrail.gap"
           drools:adHoc="false">

    <!-- Process variables -->
    <property id="trainId"          itemSubjectRef="_trainIdItem"/>
    <property id="trainUid"         itemSubjectRef="_trainUidItem"/>
    <property id="scheduleDate"     itemSubjectRef="_scheduleDateItem"/>
    <property id="severity"         itemSubjectRef="_severityItem"/>
    <property id="missedStops"      itemSubjectRef="_missedStopsItem"/>
    <property id="totalStops"       itemSubjectRef="_totalStopsItem"/>
    <!-- Comma-separated list of numeric predicted_gaps IDs for pending stops -->
    <property id="pendingStopIds"   itemSubjectRef="_pendingStopIdsItem"/>
    <!-- Deep-link back to the existing approvals UI for this journey -->
    <property id="journeyUrl"       itemSubjectRef="_journeyUrlItem"/>
    <!-- Base URL of the Next.js API, e.g. http://frontend:3000 -->
    <property id="apiBaseUrl"       itemSubjectRef="_apiBaseUrlItem"/>
    <!-- Operator decision: APPROVE_ALL | REJECT_ALL | PARTIAL -->
    <property id="approvalDecision" itemSubjectRef="_approvalDecisionItem"/>
    <property id="approvedTime"     itemSubjectRef="_approvedTimeItem"/>
    <property id="rejectionReason"  itemSubjectRef="_rejectionReasonItem"/>
    <property id="httpResponse"     itemSubjectRef="_httpResponseItem"/>

    <!-- ── Start ──────────────────────────────────────────────────────── -->
    <startEvent id="startEvent" name="Journey Gap Detected"
                drools:bgcolor="#5fb3b3">
      <documentation>
        Process is started by the gap-approval-starter worker which polls
        /api/predicted-gaps for PENDING journeys and starts one instance
        per journey. Required input variables: trainId, trainUid,
        scheduleDate, severity, missedStops, totalStops, apiBaseUrl.
      </documentation>
      <outgoing>flow_start_to_fetchStops</outgoing>
    </startEvent>

    <!-- ── Service Task: Fetch Stop IDs ──────────────────────────────── -->
    <!--
      Calls GET /api/predicted-gaps/journey/{trainId}?scheduleStartDate={scheduleDate}
      and extracts the comma-separated list of numeric predicted_gaps.id values
      for all PENDING stops, stored in pendingStopIds.

      Uses the built-in jBPM REST work item handler.
      The response is a JSON string; MVEL in the post-handler extracts the ids.
    -->
    <scriptTask id="fetchStopsTask"
                name="Fetch Pending Stop IDs"
                scriptFormat="http://www.java.com/java">
      <script>
        // GET /api/predicted-gaps/journey/{trainId}?scheduleStartDate={scheduleDate}
        // Extract comma-separated IDs of all PENDING stops → store in pendingStopIds.
        String fetchBaseUrl  = (String) kcontext.getVariable("apiBaseUrl");
        String fetchTrainId  = (String) kcontext.getVariable("trainId");
        String fetchSchedDate = (String) kcontext.getVariable("scheduleDate");
        String path = fetchBaseUrl + "/api/predicted-gaps/journey/" + fetchTrainId
                    + (fetchSchedDate != null &amp;&amp; !fetchSchedDate.isEmpty()
                       ? "?scheduleStartDate=" + java.net.URLEncoder.encode(fetchSchedDate, "UTF-8") : "");
        java.net.URL url = new java.net.URL(path);
        java.net.HttpURLConnection conn = (java.net.HttpURLConnection) url.openConnection();
        conn.setRequestMethod("GET");
        conn.setRequestProperty("Accept", "application/json");
        int status = conn.getResponseCode();
        StringBuilder sb = new StringBuilder();
        if (status == 200) {
            java.io.BufferedReader br = new java.io.BufferedReader(
                new java.io.InputStreamReader(conn.getInputStream(), "UTF-8"));
            String line;
            while ((line = br.readLine()) != null) sb.append(line);
            br.close();
        }
        conn.disconnect();
        // Extract numeric ids where approval_status is PENDING.
        // JSON contains: "stops":[...{"id":"123","approval_status":"PENDING",...},...]
        String json = sb.toString();
        StringBuilder ids = new StringBuilder();
        int i = 0;
        while ((i = json.indexOf("\"id\":", i)) != -1) {
            // get the id value
            int q1 = json.indexOf("\"", i + 5);
            int q2 = json.indexOf("\"", q1 + 1);
            String id = (q1 >= 0 &amp;&amp; q2 > q1) ? json.substring(q1 + 1, q2) : null;
            // check approval_status within the next ~200 chars
            String slice = (q2 > 0 &amp;&amp; q2 + 200 &lt; json.length()) ? json.substring(q2, q2 + 200) : "";
            if (id != null &amp;&amp; id.matches("\\d+") &amp;&amp; slice.contains("\"approval_status\":\"PENDING\"")) {
                if (ids.length() > 0) ids.append(",");
                ids.append(id);
            }
            i = q2 + 1;
        }
        kcontext.setVariable("pendingStopIds", ids.toString());
      </script>
      <incoming>flow_start_to_fetchStops</incoming>
      <outgoing>flow_fetchStops_to_reviewTask</outgoing>
    </scriptTask>

    <!-- ── User Task: Review Journey ─────────────────────────────────── -->
    <!--
      Operator opens the task in Business Central (PAM Task Inbox) and
      either bulk-approves, bulk-rejects, or marks PARTIAL (individual
      stop review follows).  The journeyUrl deep-link opens the existing
      approvals UI so the operator can see the full stop timeline.
    -->
    <userTask id="reviewJourneyTask"
              name="Review Journey Gaps"
              drools:taskName="Review Journey Gaps"
              drools:groupId="gap-approvers">
      <documentation>
        Review the predicted infill times for all missed stops on this journey.
        Use the Journey Link to open the full stop timeline in the approvals UI.

        Decision options:
          APPROVE_ALL  — accept all predicted times as-is
          REJECT_ALL   — reject all predictions (data quality issue)
          PARTIAL      — proceed to per-stop review task
      </documentation>
      <!-- SLA: escalate after 4 hours if no action taken -->
      <extensionElements>
        <drools:metaData name="customSLADueDate">
          <drools:metaValue>4h</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="elementname">
          <drools:metaValue>Review Journey Gaps</drools:metaValue>
        </drools:metaData>
      </extensionElements>
      <ioSpecification>
        <dataInput  id="in_rt_trainId"      name="trainId"/>
        <dataInput  id="in_rt_trainUid"     name="trainUid"/>
        <dataInput  id="in_rt_schedDate"    name="scheduleDate"/>
        <dataInput  id="in_rt_severity"     name="severity"/>
        <dataInput  id="in_rt_missed"       name="missedStops"/>
        <dataInput  id="in_rt_total"        name="totalStops"/>
        <dataInput  id="in_rt_stopIds"      name="pendingStopIds"/>
        <dataInput  id="in_rt_journeyUrl"   name="journeyUrl"/>
        <dataOutput id="out_rt_decision"    name="approvalDecision"/>
        <dataOutput id="out_rt_time"        name="approvedTime"/>
        <dataOutput id="out_rt_reason"      name="rejectionReason"/>
        <inputSet>
          <dataInputRefs>in_rt_trainId</dataInputRefs>
          <dataInputRefs>in_rt_trainUid</dataInputRefs>
          <dataInputRefs>in_rt_schedDate</dataInputRefs>
          <dataInputRefs>in_rt_severity</dataInputRefs>
          <dataInputRefs>in_rt_missed</dataInputRefs>
          <dataInputRefs>in_rt_total</dataInputRefs>
          <dataInputRefs>in_rt_stopIds</dataInputRefs>
          <dataInputRefs>in_rt_journeyUrl</dataInputRefs>
        </inputSet>
        <outputSet>
          <dataOutputRefs>out_rt_decision</dataOutputRefs>
          <dataOutputRefs>out_rt_time</dataOutputRefs>
          <dataOutputRefs>out_rt_reason</dataOutputRefs>
        </outputSet>
      </ioSpecification>
      <dataInputAssociation>
        <sourceRef>trainId</sourceRef>       <targetRef>in_rt_trainId</targetRef>
      </dataInputAssociation>
      <dataInputAssociation>
        <sourceRef>trainUid</sourceRef>      <targetRef>in_rt_trainUid</targetRef>
      </dataInputAssociation>
      <dataInputAssociation>
        <sourceRef>scheduleDate</sourceRef>  <targetRef>in_rt_schedDate</targetRef>
      </dataInputAssociation>
      <dataInputAssociation>
        <sourceRef>severity</sourceRef>      <targetRef>in_rt_severity</targetRef>
      </dataInputAssociation>
      <dataInputAssociation>
        <sourceRef>missedStops</sourceRef>   <targetRef>in_rt_missed</targetRef>
      </dataInputAssociation>
      <dataInputAssociation>
        <sourceRef>totalStops</sourceRef>    <targetRef>in_rt_total</targetRef>
      </dataInputAssociation>
      <dataInputAssociation>
        <sourceRef>pendingStopIds</sourceRef><targetRef>in_rt_stopIds</targetRef>
      </dataInputAssociation>
      <dataInputAssociation>
        <sourceRef>journeyUrl</sourceRef>    <targetRef>in_rt_journeyUrl</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation>
        <sourceRef>out_rt_decision</sourceRef><targetRef>approvalDecision</targetRef>
      </dataOutputAssociation>
      <dataOutputAssociation>
        <sourceRef>out_rt_time</sourceRef>    <targetRef>approvedTime</targetRef>
      </dataOutputAssociation>
      <dataOutputAssociation>
        <sourceRef>out_rt_reason</sourceRef>  <targetRef>rejectionReason</targetRef>
      </dataOutputAssociation>
      <incoming>flow_fetchStops_to_reviewTask</incoming>
      <outgoing>flow_reviewTask_to_gw</outgoing>
    </userTask>

    <!-- SLA boundary timer: 4 h → auto-approve -->
    <boundaryEvent id="slaTimer"
                   name="SLA 4h"
                   cancelActivity="true"
                   attachedToRef="reviewJourneyTask">
      <outgoing>flow_sla_to_autoApprove</outgoing>
      <timerEventDefinition>
        <timeDuration xsi:type="tFormalExpression">PT4H</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>

    <!-- ── Exclusive Gateway: Decision ───────────────────────────────── -->
    <exclusiveGateway id="decisionGW"
                      name="Decision"
                      gatewayDirection="Diverging">
      <incoming>flow_reviewTask_to_gw</incoming>
      <outgoing>flow_gw_to_approveAll</outgoing>
      <outgoing>flow_gw_to_rejectAll</outgoing>
      <outgoing>flow_gw_to_perStop</outgoing>
    </exclusiveGateway>

    <!-- ── Service Task: Approve All Stops ───────────────────────────── -->
    <!--
      Calls PATCH /api/predicted-gaps/{id} with action=approve for every
      stop ID in pendingStopIds.  Implemented as a script task using MVEL
      that iterates the comma-separated list and fires the REST calls.
    -->
    <scriptTask id="approveAllTask"
                name="Approve All Stops"
                scriptFormat="http://www.java.com/java"
                drools:bgcolor="#a7f0ba">
      <script>
        // Iterate pendingStopIds and PATCH each one as approved
        String approveBaseUrl = (String) kcontext.getVariable("apiBaseUrl");
        String approveStopIds = (String) kcontext.getVariable("pendingStopIds");
        String approveTime    = (String) kcontext.getVariable("approvedTime");
        if (approveStopIds != null &amp;&amp; !approveStopIds.trim().isEmpty()) {
            for (String id : approveStopIds.split(",")) {
                id = id.trim();
                if (!id.isEmpty()) {
                    String body = "{\"action\":\"approve\""
                        + (approveTime != null &amp;&amp; !approveTime.isEmpty()
                           ? ",\"approved_time\":\"" + approveTime + "\",\"approved_by\":\"bamoe-workflow\""
                           : ",\"approved_by\":\"bamoe-workflow\"")
                        + "}";
                    java.net.URL url = new java.net.URL(approveBaseUrl + "/api/predicted-gaps/" + id);
                    java.net.HttpURLConnection conn = (java.net.HttpURLConnection) url.openConnection();
                    conn.setRequestMethod("PATCH");
                    conn.setRequestProperty("Content-Type", "application/json");
                    conn.setDoOutput(true);
                    conn.getOutputStream().write(body.getBytes("UTF-8"));
                    conn.getResponseCode(); // fire and read status
                    conn.disconnect();
                }
            }
        }
      </script>
      <incoming>flow_gw_to_approveAll</incoming>
      <outgoing>flow_approveAll_to_end</outgoing>
    </scriptTask>

    <!-- ── Service Task: Reject All Stops ────────────────────────────── -->
    <scriptTask id="rejectAllTask"
                name="Reject All Stops"
                scriptFormat="http://www.java.com/java"
                drools:bgcolor="#ffd7d9">
      <script>
        String rejectBaseUrl = (String) kcontext.getVariable("apiBaseUrl");
        String rejectStopIds = (String) kcontext.getVariable("pendingStopIds");
        String rejectReason  = (String) kcontext.getVariable("rejectionReason");
        if (rejectReason == null) rejectReason = "Rejected via BAMOE workflow";
        if (rejectStopIds != null &amp;&amp; !rejectStopIds.trim().isEmpty()) {
            for (String id : rejectStopIds.split(",")) {
                id = id.trim();
                if (!id.isEmpty()) {
                    String body = "{\"action\":\"reject\",\"rejection_reason\":\""
                        + rejectReason.replace("\"","\\\"")
                        + "\",\"approved_by\":\"bamoe-workflow\"}";
                    java.net.URL url = new java.net.URL(rejectBaseUrl + "/api/predicted-gaps/" + id);
                    java.net.HttpURLConnection conn = (java.net.HttpURLConnection) url.openConnection();
                    conn.setRequestMethod("PATCH");
                    conn.setRequestProperty("Content-Type", "application/json");
                    conn.setDoOutput(true);
                    conn.getOutputStream().write(body.getBytes("UTF-8"));
                    conn.getResponseCode();
                    conn.disconnect();
                }
            }
        }
      </script>
      <incoming>flow_gw_to_rejectAll</incoming>
      <outgoing>flow_rejectAll_to_end</outgoing>
    </scriptTask>

    <!-- ── User Task: Per-Stop Review (PARTIAL path) ─────────────────── -->
    <!--
      When the operator chooses PARTIAL, a second task opens allowing them
      to enter individual stop-level decisions as a JSON blob.
      Format: [{"id":"123","action":"approve"},{"id":"124","action":"reject","reason":"..."}]
      Stored in httpResponse (reused as a scratch variable).
    -->
    <userTask id="perStopReviewTask"
              name="Per-Stop Review"
              drools:taskName="Per-Stop Review"
              drools:groupId="gap-approvers">
      <documentation>
        Enter individual approval decisions for each stop.
        Paste a JSON array into the stopDecisions field:
        [
          {"id":"123","action":"approve"},
          {"id":"124","action":"approve","approved_time":"14:32"},
          {"id":"125","action":"reject","reason":"Incorrect prediction"}
        ]
        Stop IDs to review: #{pendingStopIds}
        Full journey: #{journeyUrl}
      </documentation>
      <extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue>Per-Stop Review</drools:metaValue>
        </drools:metaData>
      </extensionElements>
      <ioSpecification>
        <dataInput  id="in_ps_stopIds"     name="pendingStopIds"/>
        <dataInput  id="in_ps_journeyUrl"  name="journeyUrl"/>
        <dataOutput id="out_ps_decisions"  name="stopDecisions"/>
        <inputSet>
          <dataInputRefs>in_ps_stopIds</dataInputRefs>
          <dataInputRefs>in_ps_journeyUrl</dataInputRefs>
        </inputSet>
        <outputSet>
          <dataOutputRefs>out_ps_decisions</dataOutputRefs>
        </outputSet>
      </ioSpecification>
      <dataInputAssociation>
        <sourceRef>pendingStopIds</sourceRef><targetRef>in_ps_stopIds</targetRef>
      </dataInputAssociation>
      <dataInputAssociation>
        <sourceRef>journeyUrl</sourceRef>   <targetRef>in_ps_journeyUrl</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation>
        <sourceRef>out_ps_decisions</sourceRef><targetRef>httpResponse</targetRef>
      </dataOutputAssociation>
      <incoming>flow_gw_to_perStop</incoming>
      <outgoing>flow_perStop_to_applyDecisions</outgoing>
    </userTask>

    <!-- ── Script Task: Apply Per-Stop Decisions ─────────────────────── -->
    <scriptTask id="applyDecisionsTask"
                name="Apply Per-Stop Decisions"
                scriptFormat="http://www.java.com/java">
      <script>
        // httpResponse holds JSON array of per-stop decisions from the user task.
        // Parse and PATCH each stop individually.
        String partialBaseUrl   = (String) kcontext.getVariable("apiBaseUrl");
        String partialDecisions = (String) kcontext.getVariable("httpResponse");
        if (partialDecisions != null &amp;&amp; !partialDecisions.trim().isEmpty()) {
            partialDecisions = partialDecisions.trim();
            if (partialDecisions.startsWith("[")) partialDecisions = partialDecisions.substring(1);
            if (partialDecisions.endsWith("]"))   partialDecisions = partialDecisions.substring(0, partialDecisions.length()-1);
            for (String entry : partialDecisions.split("\\},\\s*\\{")) {
                entry = entry.replace("{","").replace("}","").trim();
                String pId = null, pAction = null, pApprovedTime = null, pReason = null;
                for (String kv : entry.split(",")) {
                    String[] parts = kv.split(":", 2);
                    if (parts.length == 2) {
                        String k = parts[0].trim().replace("\"","");
                        String v = parts[1].trim().replace("\"","");
                        if ("id".equals(k))            pId = v;
                        else if ("action".equals(k))   pAction = v;
                        else if ("approved_time".equals(k)) pApprovedTime = v;
                        else if ("reason".equals(k))   pReason = v;
                    }
                }
                if (pId != null &amp;&amp; pAction != null) {
                    String body;
                    if ("approve".equals(pAction)) {
                        body = "{\"action\":\"approve\",\"approved_by\":\"bamoe-workflow\""
                            + (pApprovedTime != null ? ",\"approved_time\":\"" + pApprovedTime + "\"" : "")
                            + "}";
                    } else {
                        body = "{\"action\":\"reject\",\"approved_by\":\"bamoe-workflow\""
                            + (pReason != null ? ",\"rejection_reason\":\"" + pReason.replace("\"","\\\"") + "\"" : "")
                            + "}";
                    }
                    java.net.URL url = new java.net.URL(partialBaseUrl + "/api/predicted-gaps/" + pId);
                    java.net.HttpURLConnection conn = (java.net.HttpURLConnection) url.openConnection();
                    conn.setRequestMethod("PATCH");
                    conn.setRequestProperty("Content-Type", "application/json");
                    conn.setDoOutput(true);
                    conn.getOutputStream().write(body.getBytes("UTF-8"));
                    conn.getResponseCode();
                    conn.disconnect();
                }
            }
        }
      </script>
      <incoming>flow_perStop_to_applyDecisions</incoming>
      <outgoing>flow_applyDecisions_to_end</outgoing>
    </scriptTask>

    <!-- ── Script Task: Auto-Approve (SLA expiry) ────────────────────── -->
    <scriptTask id="autoApproveTask"
                name="Auto-Approve (SLA Expired)"
                scriptFormat="http://www.java.com/java"
                drools:bgcolor="#d0e2ff">
      <documentation>
        Triggered by the 4-hour SLA boundary timer on the Review task.
        Automatically approves all pending stops with approved_by=bamoe-sla.
      </documentation>
      <script>
        String slaBaseUrl = (String) kcontext.getVariable("apiBaseUrl");
        String slaStopIds = (String) kcontext.getVariable("pendingStopIds");
        if (slaStopIds != null &amp;&amp; !slaStopIds.trim().isEmpty()) {
            for (String id : slaStopIds.split(",")) {
                id = id.trim();
                if (!id.isEmpty()) {
                    String body = "{\"action\":\"approve\",\"approved_by\":\"bamoe-sla-auto\"}";
                    java.net.URL url = new java.net.URL(slaBaseUrl + "/api/predicted-gaps/" + id);
                    java.net.HttpURLConnection conn = (java.net.HttpURLConnection) url.openConnection();
                    conn.setRequestMethod("PATCH");
                    conn.setRequestProperty("Content-Type", "application/json");
                    conn.setDoOutput(true);
                    conn.getOutputStream().write(body.getBytes("UTF-8"));
                    conn.getResponseCode();
                    conn.disconnect();
                }
            }
        }
      </script>
      <incoming>flow_sla_to_autoApprove</incoming>
      <outgoing>flow_autoApprove_to_end</outgoing>
    </scriptTask>

    <!-- ── End Events ─────────────────────────────────────────────────── -->
    <!-- jBPM 7 rule: each endEvent may have only ONE incoming sequence flow -->
    <endEvent id="endApproveAll"  name="Approved">        <incoming>flow_approveAll_to_end</incoming></endEvent>
    <endEvent id="endRejectAll"   name="Rejected">        <incoming>flow_rejectAll_to_end</incoming></endEvent>
    <endEvent id="endPartial"     name="Partial Complete"><incoming>flow_applyDecisions_to_end</incoming></endEvent>
    <endEvent id="endAutoApprove" name="SLA Auto-Approved"><incoming>flow_autoApprove_to_end</incoming></endEvent>

    <!-- ── Sequence Flows ─────────────────────────────────────────────── -->
    <sequenceFlow id="flow_start_to_fetchStops"      sourceRef="startEvent"          targetRef="fetchStopsTask"/>
    <sequenceFlow id="flow_fetchStops_to_reviewTask"  sourceRef="fetchStopsTask"       targetRef="reviewJourneyTask"/>
    <sequenceFlow id="flow_reviewTask_to_gw"          sourceRef="reviewJourneyTask"    targetRef="decisionGW"/>
    <sequenceFlow id="flow_sla_to_autoApprove"        sourceRef="slaTimer"             targetRef="autoApproveTask"/>
    <sequenceFlow id="flow_autoApprove_to_end"        sourceRef="autoApproveTask"      targetRef="endAutoApprove"/>

    <sequenceFlow id="flow_gw_to_approveAll" name="Approve All" sourceRef="decisionGW" targetRef="approveAllTask">
      <conditionExpression xsi:type="tFormalExpression">return "APPROVE_ALL".equals(approvalDecision);</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_gw_to_rejectAll" name="Reject All" sourceRef="decisionGW" targetRef="rejectAllTask">
      <conditionExpression xsi:type="tFormalExpression">return "REJECT_ALL".equals(approvalDecision);</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_gw_to_perStop" name="Per Stop" sourceRef="decisionGW" targetRef="perStopReviewTask">
      <conditionExpression xsi:type="tFormalExpression">return "PARTIAL".equals(approvalDecision) || (approvalDecision == null);</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="flow_approveAll_to_end"         sourceRef="approveAllTask"    targetRef="endApproveAll"/>
    <sequenceFlow id="flow_rejectAll_to_end"          sourceRef="rejectAllTask"      targetRef="endRejectAll"/>
    <sequenceFlow id="flow_perStop_to_applyDecisions" sourceRef="perStopReviewTask"  targetRef="applyDecisionsTask"/>
    <sequenceFlow id="flow_applyDecisions_to_end"     sourceRef="applyDecisionsTask" targetRef="endPartial"/>

  </process>

  <!-- ═══════════════════════════════════════════════════════════════════
       BPMN DI — diagram layout
       ═══════════════════════════════════════════════════════════════════ -->
  <bpmndi:BPMNDiagram id="diagram" name="Gap Approval Process">
    <bpmndi:BPMNPlane id="plane" bpmnElement="GapApprovalProcess">

      <!-- Start -->
      <bpmndi:BPMNShape id="startEvent_di" bpmnElement="startEvent">
        <dc:Bounds x="60" y="200" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="36" y="242" width="88" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Fetch Stops -->
      <bpmndi:BPMNShape id="fetchStopsTask_di" bpmnElement="fetchStopsTask">
        <dc:Bounds x="150" y="178" width="140" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Review Journey (User Task) -->
      <bpmndi:BPMNShape id="reviewJourneyTask_di" bpmnElement="reviewJourneyTask">
        <dc:Bounds x="350" y="178" width="160" height="80"/>
      </bpmndi:BPMNShape>

      <!-- SLA Timer boundary -->
      <bpmndi:BPMNShape id="slaTimer_di" bpmnElement="slaTimer">
        <dc:Bounds x="412" y="240" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="400" y="282" width="60" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Decision GW -->
      <bpmndi:BPMNShape id="decisionGW_di" bpmnElement="decisionGW" isMarkerVisible="true">
        <dc:Bounds x="575" y="193" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="560" y="249" width="80" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Approve All -->
      <bpmndi:BPMNShape id="approveAllTask_di" bpmnElement="approveAllTask">
        <dc:Bounds x="690" y="80" width="160" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Reject All -->
      <bpmndi:BPMNShape id="rejectAllTask_di" bpmnElement="rejectAllTask">
        <dc:Bounds x="690" y="178" width="160" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Per-Stop User Task -->
      <bpmndi:BPMNShape id="perStopReviewTask_di" bpmnElement="perStopReviewTask">
        <dc:Bounds x="690" y="290" width="160" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Apply Decisions -->
      <bpmndi:BPMNShape id="applyDecisionsTask_di" bpmnElement="applyDecisionsTask">
        <dc:Bounds x="900" y="290" width="160" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Auto-Approve (SLA) -->
      <bpmndi:BPMNShape id="autoApproveTask_di" bpmnElement="autoApproveTask">
        <dc:Bounds x="350" y="380" width="160" height="80"/>
      </bpmndi:BPMNShape>

      <!-- End events — one per terminal path -->
      <bpmndi:BPMNShape id="endApproveAll_di" bpmnElement="endApproveAll">
        <dc:Bounds x="1120" y="102" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1096" y="144" width="84" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endRejectAll_di" bpmnElement="endRejectAll">
        <dc:Bounds x="1120" y="200" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1110" y="242" width="56" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endPartial_di" bpmnElement="endPartial">
        <dc:Bounds x="1120" y="312" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1096" y="354" width="84" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endAutoApprove_di" bpmnElement="endAutoApprove">
        <dc:Bounds x="560" y="402" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="536" y="444" width="84" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Flows -->
      <bpmndi:BPMNEdge id="flow_start_to_fetchStops_di" bpmnElement="flow_start_to_fetchStops">
        <di:waypoint x="96"  y="218"/><di:waypoint x="150" y="218"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_fetchStops_to_reviewTask_di" bpmnElement="flow_fetchStops_to_reviewTask">
        <di:waypoint x="290" y="218"/><di:waypoint x="350" y="218"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reviewTask_to_gw_di" bpmnElement="flow_reviewTask_to_gw">
        <di:waypoint x="510" y="218"/><di:waypoint x="575" y="218"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_sla_to_autoApprove_di" bpmnElement="flow_sla_to_autoApprove">
        <di:waypoint x="430" y="276"/><di:waypoint x="430" y="380"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_autoApprove_to_end_di" bpmnElement="flow_autoApprove_to_end">
        <di:waypoint x="510" y="420"/><di:waypoint x="560" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw_to_approveAll_di" bpmnElement="flow_gw_to_approveAll">
        <di:waypoint x="600" y="193"/><di:waypoint x="600" y="120"/><di:waypoint x="690" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw_to_rejectAll_di" bpmnElement="flow_gw_to_rejectAll">
        <di:waypoint x="625" y="218"/><di:waypoint x="690" y="218"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw_to_perStop_di" bpmnElement="flow_gw_to_perStop">
        <di:waypoint x="600" y="243"/><di:waypoint x="600" y="330"/><di:waypoint x="690" y="330"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_approveAll_to_end_di" bpmnElement="flow_approveAll_to_end">
        <di:waypoint x="850" y="120"/><di:waypoint x="1120" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_rejectAll_to_end_di" bpmnElement="flow_rejectAll_to_end">
        <di:waypoint x="850" y="218"/><di:waypoint x="1120" y="218"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_perStop_to_applyDecisions_di" bpmnElement="flow_perStop_to_applyDecisions">
        <di:waypoint x="850" y="330"/><di:waypoint x="900" y="330"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_applyDecisions_to_end_di" bpmnElement="flow_applyDecisions_to_end">
        <di:waypoint x="1060" y="330"/><di:waypoint x="1120" y="330"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
