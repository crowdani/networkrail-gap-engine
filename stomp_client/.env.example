# Network Rail STOMP feed credentials
# Register at: https://datafeeds.networkrail.co.uk/
NR_USERNAME=your-email@example.com
NR_PASSWORD=your-password

# ---------------------------------------------------------------------------
# Kafka broker — choose one depending on your environment
# ---------------------------------------------------------------------------

# LOCAL (podman / docker-compose — apache/kafka container on port 9092)
KAFKA_BROKER=localhost:9092

# OPENSHIFT — Confluent Platform bootstrap in the 'confluent' namespace
# Uncomment this line (and comment out the one above) when running on-cluster:
# KAFKA_BROKER=kafka-0.kafka.confluent.svc.cluster.local:9092
